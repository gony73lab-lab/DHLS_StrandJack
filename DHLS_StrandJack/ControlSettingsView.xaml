                            Style="{StaticResource AccentButtonStyle}"
                            Padding="14,6"
                            Click="OnSaveClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE74E;"/>
                            <TextBlock Loaded="OnLocalizedLoaded" Text="저장"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnCapture"
                            Style="{StaticResource AccentButtonStyle}"
                            Padding="14,6"
                            Click="OnCaptureClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE722;"/>
                            <TextBlock Loaded="OnLocalizedLoaded" Text="Capture"/>
                        </StackPanel>
                    </Button>

                    <Button x:Name="BtnExit"
                            Background="{StaticResource DangerButtonBrush}"
                            Foreground="White"
                            BorderBrush="{StaticResource DangerButtonBrush}"
                            Padding="14,6"
                            Click="OnExitClick">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon Glyph="&#xE711;"/>
                            <TextBlock Loaded="OnLocalizedLoaded" Text="나가기"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
    </Viewbox>
    <Grid x:Name="ArrangementOverlay" Visibility="Collapsed" Background="#F8FAFC"/>
    </Grid>
</UserControl>




