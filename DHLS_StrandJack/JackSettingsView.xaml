<?xml version="1.0" encoding="utf-8"?>
<UserControl x:Class="DHLS_StrandJack.JackSettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Background="White" FontFamily="Malgun Gothic" RequestedTheme="Light">
  <UserControl.Resources>
    <SolidColorBrush x:Key="CylinderColorBrush" Color="Yellow"/>
    <SolidColorBrush x:Key="PistonColorBrush" Color="Black"/>
    <SolidColorBrush x:Key="DangerButtonBrush" Color="Firebrick"/>
    <Style x:Key="SettingNumber" TargetType="NumberBox">
      <Setter Property="Width" Value="120"/>
      <Setter Property="Height" Value="32"/>
      <Setter Property="MinWidth" Value="0"/>
      <Setter Property="Minimum" Value="0"/>
      <Setter Property="Maximum" Value="999999"/>
      <Setter Property="SmallChange" Value="1"/>
      <Setter Property="LargeChange" Value="10"/>
      <Setter Property="SpinButtonPlacementMode" Value="Compact"/>
      <Setter Property="IsWrapEnabled" Value="False"/>
      <Setter Property="HorizontalAlignment" Value="Left"/>
      <Setter Property="FontSize" Value="16"/>
    </Style>
    <Style x:Key="SettingLabel" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="HorizontalAlignment" Value="Right"/>
      <Setter Property="Margin" Value="0,0,9,0"/>
    </Style>
    <Style x:Key="SettingUnit" TargetType="TextBlock">
      <Setter Property="FontSize" Value="16"/>
      <Setter Property="Foreground" Value="Black"/>
      <Setter Property="VerticalAlignment" Value="Center"/>
      <Setter Property="Margin" Value="9,0,0,0"/>
    </Style>
    <Style x:Key="CalculatedValue" TargetType="TextBox">
      <Setter Property="Height" Value="35"/>
      <Setter Property="FontSize" Value="18"/>
      <Setter Property="Foreground" Value="#707070"/>
      <Setter Property="Background" Value="#F5F5F5"/>
      <Setter Property="BorderBrush" Value="White"/>
      <Setter Property="BorderThickness" Value="1"/>
      <Setter Property="IsReadOnly" Value="True"/>
      <Setter Property="HorizontalContentAlignment" Value="Center"/>
    </Style>
  </UserControl.Resources>
  <Viewbox Stretch="Uniform" StretchDirection="DownOnly">
    <Border Width="980" Height="588" Background="White" BorderBrush="LightGray" BorderThickness="1" CornerRadius="8">
      <Grid>
        <Grid.RowDefinitions>
          <RowDefinition Height="56"/>
          <RowDefinition Height="*"/>
          <RowDefinition Height="64"/>
        </Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="LightGray" BorderThickness="0,0,0,1">
          <Grid Margin="24,0,20,0">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <TextBlock Loaded="OnLocalizedLoaded" Text="스트랜드잭 설정" FontSize="22" FontWeight="SemiBold" Foreground="Black" VerticalAlignment="Center"/>
            <Button Loaded="OnLocalizedLoaded" Grid.Column="1" Width="40" Height="40" Background="Transparent" BorderThickness="0"
                                Click="OnExitClick" AutomationProperties.Name="닫기">
              <FontIcon Glyph="&#xE711;"/>
            </Button>
          </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="16">
          <Grid ColumnSpacing="14" VerticalAlignment="Top">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="440"/>
              <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" BorderBrush="LightGray" BorderThickness="1" Background="White"
                                    CornerRadius="6" VerticalAlignment="Top" Height="434">
              <Grid Margin="14,14,14,12" RowSpacing="4">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="190"/>
                  <ColumnDefinition Width="132"/>
                  <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                  <RowDefinition Height="40"/>
                  <RowDefinition Height="32"/>
                  <RowDefinition Height="32"/>
                  <RowDefinition Height="32"/>
                  <RowDefinition Height="32"/>
                  <RowDefinition Height="32"/>
                  <RowDefinition Height="32"/>
                  <RowDefinition Height="32"/>
                  <RowDefinition Height="32"/>
                  <RowDefinition Height="32"/>
                  <RowDefinition Height="32"/>
                </Grid.RowDefinitions>
                <TextBlock Loaded="OnLocalizedLoaded" Grid.Row="0" Text="잭 종류" Style="{StaticResource SettingLabel}"/>
                <ComboBox x:Name="CmbJackType" Grid.Row="0" Grid.Column="1" Grid.ColumnSpan="2"
                                              Width="180" Height="38" HorizontalAlignment="Left" IsEditable="True"/>
                <TextBlock Loaded="OnLocalizedLoaded" Grid.Row="1" Text="웨지열림 확인시간" Style="{StaticResource SettingLabel}"/>
                <NumberBox x:Name="TxtWedgeOpen" Grid.Row="1" Grid.Column="1" Style="{StaticResource SettingNumber}"/>
                <TextBlock Grid.Row="1" Grid.Column="2" Text="sec" Style="{StaticResource SettingUnit}"/>
                <TextBlock Loaded="OnLocalizedLoaded" Grid.Row="2" Text="웨지닫힘 확인시간" Style="{StaticResource SettingLabel}"/>
                <NumberBox x:Name="TxtWedgeClose" Grid.Row="2" Grid.Column="1" Style="{StaticResource SettingNumber}"/>
                <TextBlock Grid.Row="2" Grid.Column="2" Text="sec" Style="{StaticResource SettingUnit}"/>
                <TextBlock Loaded="OnLocalizedLoaded" Grid.Row="3" Text="하중전이 범위" Style="{StaticResource SettingLabel}"/>
                <NumberBox x:Name="TxtLoadTransfer" Grid.Row="3" Grid.Column="1" Style="{StaticResource SettingNumber}"/>
                <TextBlock Grid.Row="3" Grid.Column="2" Text="mm" Style="{StaticResource SettingUnit}"/>
                <TextBlock Loaded="OnLocalizedLoaded" Grid.Row="4" Text="안전 범위" Style="{StaticResource SettingLabel}"/>
                <NumberBox x:Name="TxtSafeRange" Grid.Row="4" Grid.Column="1" Style="{StaticResource SettingNumber}"/>
                <TextBlock Grid.Row="4" Grid.Column="2" Text="mm" Style="{StaticResource SettingUnit}"/>
                <TextBlock Loaded="OnLocalizedLoaded" Grid.Row="5" Text="최대 하중 가동 범위" Style="{StaticResource SettingLabel}"/>
                <NumberBox Loaded="OnLocalizedLoaded" x:Name="TxtMaxLoadOperatingRange" Grid.Row="5" Grid.Column="1" Style="{StaticResource SettingNumber}" AutomationProperties.Name="최대 하중 가동 범위 (mm)"/>
                <StackPanel Grid.Row="5" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Spacing="4">
                  <TextBlock Text="mm" Style="{StaticResource SettingUnit}" Margin="0"/>
                  <TextBlock Loaded="OnLocalizedLoaded" x:Name="MaxOperatingRangeWarning" Text="초과" Foreground="Firebrick" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Visibility="Collapsed"/>
                </StackPanel>
                <TextBlock Loaded="OnLocalizedLoaded" Grid.Row="6" Text="잭 최대하중" Style="{StaticResource SettingLabel}"/>
                <NumberBox x:Name="TxtCapacity" Grid.Row="6" Grid.Column="1" Style="{StaticResource SettingNumber}"/>
                <TextBlock Grid.Row="6" Grid.Column="2" Text="Ton" Style="{StaticResource SettingUnit}"/>
                <TextBlock Loaded="OnLocalizedLoaded" Grid.Row="7" Text="실린더 색상" Style="{StaticResource SettingLabel}"/>
                <Button x:Name="BtnCylinderColor" Grid.Row="7" Grid.Column="1" Width="96" Height="32" HorizontalAlignment="Left">
                  <Button.Flyout>
                    <Flyout>
                      <ColorPicker Width="300" IsAlphaEnabled="False"
                                                Color="{Binding Color, Source={StaticResource CylinderColorBrush}, Mode=TwoWay}"/>
                    </Flyout>
                  </Button.Flyout>
                  <Border Width="72" Height="22" Background="{StaticResource CylinderColorBrush}"/>
                </Button>
                <TextBlock Loaded="OnLocalizedLoaded" Grid.Row="8" Text="실린더 변위" Style="{StaticResource SettingLabel}"/>
                <NumberBox x:Name="TxtJackStroke" Grid.Row="8" Grid.Column="1" Style="{StaticResource SettingNumber}"/>
                <TextBlock Grid.Row="8" Grid.Column="2" Text="mm" Style="{StaticResource SettingUnit}"/>
                <TextBlock Loaded="OnLocalizedLoaded" Grid.Row="9" Text="변위센서" Style="{StaticResource SettingLabel}"/>
                <NumberBox x:Name="TxtDisplacementRange" Grid.Row="9" Grid.Column="1" Style="{StaticResource SettingNumber}"/>
                <TextBlock Grid.Row="9" Grid.Column="2" Text="mm" Style="{StaticResource SettingUnit}"/>
                <TextBlock Loaded="OnLocalizedLoaded" Grid.Row="10" Text="압력센서" Style="{StaticResource SettingLabel}"/>
                <NumberBox x:Name="TxtPressureRange" Grid.Row="10" Grid.Column="1" Style="{StaticResource SettingNumber}"/>
                <TextBlock x:Name="PressureScaleUnit" Grid.Row="10" Grid.Column="2" Text="bar" Style="{StaticResource SettingUnit}"/>
              </Grid>
            </Border>
            <Border Grid.Column="1" BorderBrush="LightGray" BorderThickness="1" Background="White"
                                    CornerRadius="6" VerticalAlignment="Top" Height="434">
              <Grid Margin="12">
                <Grid.RowDefinitions>
                  <RowDefinition Height="46"/>
                  <RowDefinition Height="242"/>
                  <RowDefinition Height="32"/>
                  <RowDefinition Height="40"/>
                  <RowDefinition Height="40"/>
                </Grid.RowDefinitions>
                <Border Background="#EFF6FF" BorderBrush="#93C5FD" BorderThickness="1"
                        CornerRadius="6" Padding="10,3" Margin="0,0,0,6">
                  <CheckBox x:Name="ShowMotionArrowCheck" Loaded="OnLocalizedLoaded"
                            Content="화살표 표시" Foreground="#1F2937" MinHeight="32"
                            Checked="ShowMotionArrowChanged" Unchecked="ShowMotionArrowChanged"/>
                </Border>
                <Grid Grid.Row="1">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="190"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <StackPanel Grid.Column="0" VerticalAlignment="Center" Spacing="20">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="D1" Width="27" FontSize="18" VerticalAlignment="Center"/>
                      <NumberBox x:Name="TxtD1" Style="{StaticResource SettingNumber}"/>
                      <TextBlock Text="mm" FontSize="17" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="D2" Width="27" FontSize="18" VerticalAlignment="Center"/>
                      <NumberBox x:Name="TxtD2" Style="{StaticResource SettingNumber}"/>
                      <TextBlock Text="mm" FontSize="17" VerticalAlignment="Center"/>
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                      <TextBlock Text="D3" Width="27" FontSize="18" VerticalAlignment="Center"/>
                      <NumberBox x:Name="TxtD3" Style="{StaticResource SettingNumber}"/>
                      <TextBlock Text="mm" FontSize="17" VerticalAlignment="Center"/>
                    </StackPanel>
                  </StackPanel>
                  <Viewbox Grid.Column="1" Width="270" Height="236" Stretch="Uniform">
                    <Canvas Width="235" Height="270" Background="#F0F0F0">
                      <!-- 1. 바깥 프레임 -->
                      <Rectangle Canvas.Left="10" Canvas.Top="8" Width="175" Height="252" Stroke="Black" StrokeThickness="3.5"/>
                      <!-- 2. 안쪽 몸통: 좌/우 검은 테두리만, 위/아래 테두리 없음 -->
                      <Border Canvas.Left="28.5" Canvas.Top="20.5" Width="126" Height="227" Background="#D9D9D9" BorderBrush="Black" BorderThickness="4.5,0,4.5,0"/>
                      <!-- 3. 회색 ⊥ 모양 (위 기둥 + 아래 띠를 하나로, 윗변은 열어 둠) -->
                      <Path Fill="#808080" Stroke="Black" StrokeThickness="2" Data="M 69,20.5 L 69,145 L 34,145 L 34,159 L 149,159 L 149,145 L 115,145 L 115,20.5"/>
                      <!-- 4. 파란 로드: 몸통 위끝부터 아래끝까지, 좌/우 테두리만 -->
                      <Border Canvas.Left="77.75" Canvas.Top="20.5" Width="25.5" Height="227" Background="#55C5F4" BorderBrush="Black" BorderThickness="1.5,0,1.5,0"/>
                      <Line X1="69" Y1="83" X2="115" Y2="83" Stroke="Red" StrokeThickness="2"/>
                      <Polygon Points="69,83 83,75 83,91" Fill="Red"/>
                      <Polygon Points="115,83 101,75 101,91" Fill="Red"/>
                      <Line X1="115" Y1="83" X2="190" Y2="83" Stroke="Red" StrokeThickness="2"/>
                      <Line X1="79" Y1="178" X2="103" Y2="178" Stroke="Red" StrokeThickness="2"/>
                      <Polygon Points="79,178 89,172 89,184" Fill="Red"/>
                      <Polygon Points="103,178 93,172 93,184" Fill="Red"/>
                      <Line X1="103" Y1="178" X2="190" Y2="178" Stroke="Red" StrokeThickness="2"/>
                      <Line X1="35" Y1="223" X2="149" Y2="223" Stroke="Red" StrokeThickness="2"/>
                      <Polygon Points="35,223 49,215 49,231" Fill="Red"/>
                      <Polygon Points="149,223 135,215 135,231" Fill="Red"/>
                      <Line X1="149" Y1="223" X2="190" Y2="223" Stroke="Red" StrokeThickness="2"/>
                      <TextBlock Canvas.Left="194" Canvas.Top="58" Text="D1" FontSize="22" Foreground="Red"/>
                      <TextBlock Canvas.Left="194" Canvas.Top="153" Text="D2" FontSize="22" Foreground="Red"/>
                      <TextBlock Canvas.Left="194" Canvas.Top="198" Text="D3" FontSize="22" Foreground="Red"/>
                    </Canvas>
                  </Viewbox>
                  <Viewbox x:Name="MotionArrowPreview" Grid.Column="1" Width="70" Height="84"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           Visibility="Collapsed" Opacity="0.7" IsHitTestVisible="False">
                    <Canvas Width="56" Height="68">
                      <Polygon Points="0,28 28,0 56,28" Fill="#FFC342"/>
                      <Rectangle Canvas.Left="15" Canvas.Top="30" Width="26" Height="7" RadiusX="2" RadiusY="2" Fill="#FFC342"/>
                      <Rectangle Canvas.Left="15" Canvas.Top="40" Width="26" Height="7" RadiusX="2" RadiusY="2" Fill="#FFC342"/>
                      <Rectangle Canvas.Left="15" Canvas.Top="50" Width="26" Height="7" RadiusX="2" RadiusY="2" Fill="#FFC342"/>
                      <Rectangle Canvas.Left="15" Canvas.Top="60" Width="26" Height="7" RadiusX="2" RadiusY="2" Fill="#FFC342"/>
                    </Canvas>
                  </Viewbox>
                </Grid>
                <Grid Grid.Row="2">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Grid.Column="1" Text="Piston surface(mm²)" FontSize="15" HorizontalAlignment="Center"/>
                  <TextBlock Grid.Column="2" Text="Pressure max.(bar)" FontSize="15" HorizontalAlignment="Center"/>
                </Grid>
                <Grid Grid.Row="3">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Loaded="OnLocalizedLoaded" Text="상승 단면적" FontSize="18" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtRiseArea" Grid.Column="1" Width="170" HorizontalAlignment="Left" Style="{StaticResource CalculatedValue}"/>
                  <TextBox x:Name="TxtMaxPressure" Grid.Column="2" Width="154" HorizontalAlignment="Left" Style="{StaticResource CalculatedValue}" Margin="8,0,0,0"/>
                </Grid>
                <Grid Grid.Row="4">
                  <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="125"/>
                    <ColumnDefinition Width="175"/>
                    <ColumnDefinition Width="*"/>
                  </Grid.ColumnDefinitions>
                  <TextBlock Loaded="OnLocalizedLoaded" Text="하강 단면적" FontSize="18" VerticalAlignment="Center"/>
                  <TextBox x:Name="TxtFallArea" Grid.Column="1" Width="170" HorizontalAlignment="Left" Style="{StaticResource CalculatedValue}"/>
                </Grid>
              </Grid>
            </Border>
          </Grid>
        </Grid>
        <Border Grid.Row="2" BorderBrush="LightGray" BorderThickness="0,1,0,0">
          <Grid Margin="16,8">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*"/>
              <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
              <Button x:Name="BtnSave" Style="{StaticResource AccentButtonStyle}" Padding="14,6" MinWidth="110" Click="OnSaveClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE74E;"/>
                  <TextBlock Text="SAVE"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnDelete" Padding="14,6" MinWidth="110" Click="OnDeleteClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE738;"/>
                  <TextBlock Text="DELETE"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8">
              <Button x:Name="BtnCapture" Style="{StaticResource AccentButtonStyle}" Padding="14,6" MinWidth="130" Click="OnCaptureClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE722;"/>
                  <TextBlock Loaded="OnLocalizedLoaded" Text="Capture"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnOK" Style="{StaticResource AccentButtonStyle}" Padding="14,6" MinWidth="110" Click="OnSaveAndExitClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE8FB;"/>
                  <TextBlock Loaded="OnLocalizedLoaded" Text="OK"/>
                </StackPanel>
              </Button>
              <Button x:Name="BtnExit" Background="{StaticResource DangerButtonBrush}" Foreground="White"
                              BorderBrush="{StaticResource DangerButtonBrush}" Padding="14,6" MinWidth="110" Click="OnExitClick">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <FontIcon Glyph="&#xE711;"/>
                  <TextBlock Loaded="OnLocalizedLoaded" Text="Cancel"/>
                </StackPanel>
              </Button>
            </StackPanel>
            <Button Loaded="OnLocalizedLoaded" x:Name="BtnAdd" Content="추가" Click="OnAddClick" Visibility="Collapsed"/>
          </Grid>
        </Border>
        <ComboBox x:Name="TxtPressureScale" Visibility="Collapsed">
          <ComboBoxItem Content="4000"/>
          <ComboBoxItem Content="16000"/>
          <ComboBoxItem Content="64000"/>
        </ComboBox>
        <ComboBox x:Name="TxtDisplacementScale" Visibility="Collapsed">
          <ComboBoxItem Content="4000"/>
          <ComboBoxItem Content="16000"/>
          <ComboBoxItem Content="64000"/>
        </ComboBox>
        <NumberBox x:Name="TxtWorkingPressure" Visibility="Collapsed"/>
        <Button x:Name="BtnPistonColor" Visibility="Collapsed"/>
      </Grid>
    </Border>
  </Viewbox>
</UserControl>
