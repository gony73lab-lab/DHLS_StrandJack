<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="DHLS_StrandJack.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DHLS_StrandJack"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Title="DHLS Strand Jack">

    <Grid Background="White">
        <!-- 1. 메인 Grid 리소스 영역에 시스템 테마 색상 덮어쓰기 -->
        <Grid.Resources>
            <SolidColorBrush x:Key="ButtonBackgroundPointerOver" Color="#0052A3" />
            <!-- 오버: 짙은 파랑 -->
            <SolidColorBrush x:Key="ButtonForegroundPointerOver" Color="White" />
            <SolidColorBrush x:Key="ButtonBackgroundPressed" Color="#003D7A" />
            <!-- 클릭: 아주 어두운 파랑 -->
            <SolidColorBrush x:Key="ButtonForegroundPressed" Color="#E0E0E0" />
        </Grid.Resources>
        
        <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border x:Name="AppPlcStatusBar" Grid.Row="1" Background="#303030" Padding="8,2" Visibility="Collapsed">
            <TextBlock x:Name="AppPlcStatusText" Foreground="White" FontSize="12" TextWrapping="Wrap"/>
        </Border>
        <!-- MainMenuView UserControl이 주입될 호스트 컨테이너 -->
        <ContentControl x:Name="MainContentHost" 
                        HorizontalAlignment="Stretch" 
                        VerticalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        VerticalContentAlignment="Stretch"/>

        <!-- 런처 버튼 컨테이너 (화면 중앙 배치) -->
        <StackPanel x:Name="LauncherPanel" 
                    HorizontalAlignment="Center" 
                    VerticalAlignment="Center" 
                    Orientation="Horizontal" 
                    Spacing="40">

            <!-- 신규 모델 버튼 -->
            <Button Loaded="OnLocalizedLoaded" 
                    Width="250" Height="120" FontSize="24"
                    Background="#757575" Foreground="White"
                    Click="{x:Bind OnNewModelClicked}">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Viewbox Width="24" Height="24" VerticalAlignment="Center">
                        <SymbolIcon Symbol="Add"/>
                    </Viewbox>
                    <TextBlock Loaded="OnLocalizedLoaded" Text="신규 모델" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>

            <!-- 기존 모델 버튼 -->
            <Button Loaded="OnLocalizedLoaded" 
                    Width="250" Height="120" FontSize="24"
                     Background="#757575" Foreground="White"
                    Click="{x:Bind OnExistingModelClicked}">
                <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
                    <Viewbox Width="24" Height="24" VerticalAlignment="Center">
                        <SymbolIcon Symbol="OpenFile"/>
                    </Viewbox>
                    <TextBlock Loaded="OnLocalizedLoaded" Text="기존 모델" VerticalAlignment="Center"/>
                </StackPanel>
            </Button>
        </StackPanel>
    </Grid>
</Window>
