<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DHLS_StrandJack.MainMenuView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:DHLS_StrandJack"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    Loaded="ConnectionView_Loaded"
    Unloaded="ConnectionView_Unloaded"
    RequestedTheme="Light"
    Background="#f1f5f9"
    FontFamily="Malgun Gothic">

    <UserControl.Resources>
        <!-- 버튼 테두리와 레이블을 분리한 템플릿 -->
        <!-- 일반 메뉴 버튼 -->
        <Style x:Key="MenuButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#868e96"/>
            <Setter Property="BorderThickness" Value="4"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <!-- 버튼 비율 유지 (텍스트와 아이콘 간격) -->
                        <StackPanel Spacing="10" Background="Transparent" HorizontalAlignment="Center">
                            <Border x:Name="IconBorder" 
                                    Background="{TemplateBinding Background}" 
                                    BorderBrush="{TemplateBinding BorderBrush}" 
                                    BorderThickness="{TemplateBinding BorderThickness}" 
                                    CornerRadius="26" Width="150" Height="150">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="scaleTransform" ScaleX="1" ScaleY="1" CenterX="75" CenterY="75"/>
                                </Border.RenderTransform>
                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{TemplateBinding Tag}" FontWeight="Black" FontSize="18" Foreground="#1f2937" HorizontalAlignment="Center"/>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal" />
                                    <VisualState x:Name="PointerOver"/>
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="scaleTransform"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.96"
                                                Duration="0:0:0.05"/>
                                            <DoubleAnimation
                                                Storyboard.TargetName="scaleTransform"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.96"
                                                Duration="0:0:0.05"/>
                                        </Storyboard>
                                    </VisualState>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                        </StackPanel>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- EXIT 버튼 전용 스타일: 색상 상태는 C++에서 제어 -->
        <Style x:Key="ExitButtonStyle" TargetType="Button">
            <Setter Property="Background" Value="White"/>
            <Setter Property="Foreground" Value="Black"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <!-- 전체 화면을 헤더, 가변 중앙(Viewbox), 푸터의 3단으로 분리 -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <!-- 고정 헤더 영역 -->
            <RowDefinition Height="*"/>
            <!-- 가변 스케일링 중앙 영역 -->
            <RowDefinition Height="100"/>
            <!-- 고정 하단 푸터 영역 -->
        </Grid.RowDefinitions>

        <!--
            MainMenuView 배경 전용 더블클릭 영역.
            다른 Button/Control의 이벤트와 충돌하지 않도록
            모든 실제 UI보다 뒤에 배치한다.
        -->
        <Border
            x:Name="MainBackgroundHitArea"
            Grid.RowSpan="3"
            Background="Transparent"
            DoubleTapped="MainMenuView_Background_DoubleTapped"/>

        <!-- [Row 0: Header] -->
        <Grid Grid.Row="0" Background="Red">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Click="OnLanguageClick" Width="110" Height="40" HorizontalAlignment="Left" Margin="40,0,20,0" 
                    Background="White" Foreground="#1f2937" BorderBrush="#9ca3af" BorderThickness="2" 
                    CornerRadius="20" Padding="0">
                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="文A" FontSize="14" FontWeight="Bold"/>
                    <TextBlock Loaded="OnLocalizedLoaded" Text="ENG" FontWeight="Black" FontSize="14"/>
                </StackPanel>
            </Button>

            <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="16,0">
            <StackPanel HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Orientation="Horizontal"
            Spacing="16">

                <TextBlock x:Name="CurrentModelNameText" Visibility="Collapsed"
                           Foreground="White" FontSize="36" FontWeight="Bold"
                           MaxWidth="240" TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center"/>

                <TextBlock Loaded="OnLocalizedLoaded" Text="STRAND JACK CONTROL"
               Foreground="White"
               FontSize="36"
               FontWeight="Bold"/>

                <!-- 배포 버전 자동 표시 -->
                <TextBlock Loaded="VersionText_Loaded"
               Foreground="#d1d5db"
               FontSize="14"
               FontWeight="SemiBold"
               VerticalAlignment="Bottom"
               Margin="0,0,0,6"/>

            </StackPanel>
            </Viewbox>

            <!-- DHLS LOGO -->
            <Button x:Name="HeaderLogoButton" Grid.Column="2" Click="HeaderLogoButton_Click"
                    Loaded="OnLocalizedLoaded" ToolTipService.ToolTip="최소화" AutomationProperties.Name="최소화"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="20,0,6,0"
                    Padding="0" Background="Transparent" BorderThickness="0">
                <Image Source="ms-appx:///Assets/DHLS_Logo_White_Transparent.png" Width="180" Stretch="Uniform"/>
            </Button>
        </Grid>

        <!-- [Row 1: Main Content] 자동 스케일링 컨테이너 Viewbox 도입 -->
        <Viewbox Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="24,36,24,24">
            <!-- 상단 3개, 하단 4개 메뉴를 중앙 정렬 -->
            <Grid Width="880" RowSpacing="28">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Menu order and pictograms follow the observed DSJ reference. -->
                <Button Loaded="OnLocalizedLoaded" Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Style="{StaticResource MenuButtonStyle}" Tag="상승 운전" Click="StrandPreview_Click"><Viewbox Width="106" Height="106"><Canvas Width="100" Height="100"><Rectangle Canvas.Left="17" Canvas.Top="13" Width="24" Height="74" Stroke="Black" StrokeThickness="3"/><Path Data="M 20,23 L 30,23 M 20,33 L 27,33 M 20,43 L 30,43 M 20,53 L 27,53 M 20,63 L 30,63 M 20,73 L 27,73" Stroke="Black" StrokeThickness="2"/><Path Canvas.Left="54" Canvas.Top="16" Width="36" Height="68" Stretch="Fill" Data="M32,3 C34,3 36,4 38,7 L60,34 C64,39 61,45 55,45 L47,45 L47,58 C47,62 44,64 40,64 L24,64 C20,64 17,62 17,58 L17,45 L9,45 C3,45 0,39 4,34 L26,7 C28,4 30,3 32,3 Z" Fill="Black"/></Canvas></Viewbox></Button>
                <Button Loaded="OnLocalizedLoaded" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="2" Style="{StaticResource MenuButtonStyle}" Tag="하강 운전" Click="StrandPreview_Click"><Viewbox Width="106" Height="106"><Canvas Width="100" Height="100"><Rectangle Canvas.Left="17" Canvas.Top="13" Width="24" Height="74" Stroke="Black" StrokeThickness="3"/><Path Data="M 20,23 L 30,23 M 20,33 L 27,33 M 20,43 L 30,43 M 20,53 L 27,53 M 20,63 L 30,63 M 20,73 L 27,73" Stroke="Black" StrokeThickness="2"/><Path Canvas.Left="54" Canvas.Top="16" Width="36" Height="68" Stretch="Fill" RenderTransformOrigin="0.5,0.5" Data="M32,3 C34,3 36,4 38,7 L60,34 C64,39 61,45 55,45 L47,45 L47,58 C47,62 44,64 40,64 L24,64 C20,64 17,62 17,58 L17,45 L9,45 C3,45 0,39 4,34 L26,7 C28,4 30,3 32,3 Z" Fill="Black"><Path.RenderTransform><RotateTransform Angle="180"/></Path.RenderTransform></Path></Canvas></Viewbox></Button>
                <Button Loaded="OnLocalizedLoaded" Grid.Row="0" Grid.Column="4" Grid.ColumnSpan="2" Style="{StaticResource MenuButtonStyle}" Tag="수동 운전" Click="StrandPreview_Click"><Viewbox Width="106" Height="106"><Canvas Width="100" Height="100"><Path Data="M 29,14 C 15,12 13,24 20,32 L 28,40 L 28,82 C 28,91 39,91 39,82 L 39,40 L 47,32 C 55,24 51,12 40,14 L 40,25 L 34,29 L 29,25 Z" Stroke="Black" StrokeThickness="3" Fill="Transparent"/><Path Data="M 66,14 L 82,14 L 80,37 L 76,42 L 76,82 C 76,90 66,90 66,82 L 66,42 L 62,37 Z" Stroke="Black" StrokeThickness="3" Fill="Transparent"/><Path Data="M 62,29 L 82,29" Stroke="Black" StrokeThickness="3"/></Canvas></Viewbox></Button>
                <Button Loaded="OnLocalizedLoaded" Grid.Row="0" Grid.Column="6" Grid.ColumnSpan="2" Style="{StaticResource MenuButtonStyle}" Tag="텐셔닝 작업" Click="StrandPreview_Click"><Viewbox Width="106" Height="106"><Canvas Width="100" Height="100"><Rectangle Canvas.Left="17" Canvas.Top="13" Width="24" Height="74" Stroke="Black" StrokeThickness="3"/><Path Data="M 20,23 L 30,23 M 20,33 L 27,33 M 20,43 L 30,43 M 20,53 L 27,53 M 20,63 L 30,63 M 20,73 L 27,73" Stroke="Black" StrokeThickness="2"/><Path Canvas.Left="58" Canvas.Top="12" Width="28" Height="35" Stretch="Fill" Data="M32,3 C34,3 36,4 38,7 L60,34 C64,39 61,45 55,45 L47,45 L47,58 C47,62 44,64 40,64 L24,64 C20,64 17,62 17,58 L17,45 L9,45 C3,45 0,39 4,34 L26,7 C28,4 30,3 32,3 Z" Fill="Black"/><Path Canvas.Left="58" Canvas.Top="53" Width="28" Height="35" Stretch="Fill" RenderTransformOrigin="0.5,0.5" Data="M32,3 C34,3 36,4 38,7 L60,34 C64,39 61,45 55,45 L47,45 L47,58 C47,62 44,64 40,64 L24,64 C20,64 17,62 17,58 L17,45 L9,45 C3,45 0,39 4,34 L26,7 C28,4 30,3 32,3 Z" Fill="Black"><Path.RenderTransform><RotateTransform Angle="180"/></Path.RenderTransform></Path></Canvas></Viewbox></Button>
                <!-- 1. STROKE CONTROL -->
                <Button Loaded="OnLocalizedLoaded" x:Name="BtnStroke" Visibility="Collapsed"
        Grid.Row="0"
        Grid.Column="1" Grid.ColumnSpan="2"
        Style="{StaticResource MenuButtonStyle}"
        Tag="STROKE CONTROL"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        PointerEntered="MenuButton_PointerEntered"
        PointerExited="MenuButton_PointerExited"
        Click="MenuButton_Click">

                    <Viewbox Width="90"
             Height="90"
             Stretch="Uniform">

                        <!-- 첨부 원본 이미지 비율 : 122 x 234 -->
                        <Grid Width="122"
              Height="234">

                            <!-- =====================================================
                 1. 눈금자 외곽 프레임
                 
                 원본 기준:
                 Left   ≒ 24
                 Right  ≒ 103
                 Top    ≒ 21
                 Bottom ≒ 227
                 
                 모서리는 살짝 둥글게
                 ===================================================== -->
                            <Path
                Data="
                    M 24,21
                    L 103,21
                    L 103,227
                    L 24,227
                    Z"
                Stroke="{x:Bind BtnStroke.Foreground, Mode=OneWay}"
                StrokeThickness="9"
                StrokeLineJoin="Round"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                Fill="Transparent"/>


                            <!-- =====================================================
                 2. 내부 세로 분할선
                 
                 첨부 이미지에서 오른쪽 약 1/4 영역을
                 분리하는 수직선
                 ===================================================== -->
                            <Path
                Data="M 81,21 L 81,227"
                Stroke="{x:Bind BtnStroke.Foreground, Mode=OneWay}"
                StrokeThickness="9"
                StrokeStartLineCap="Square"
                StrokeEndLineCap="Square"/>


                            <!-- =====================================================
                 3. 눈금 Tick Marks
                 
                 원본 실제 배치:
                 Y = 43 / 70 / 97 / 124 / 151 / 178 / 205

                 짧은 눈금 : 약 X=24 → 41
                 긴 눈금   : 약 X=24 → 56
                 ===================================================== -->

                            <!-- 1 : 짧은 눈금 -->
                            <Path
                Data="M 24,43 L 41,43"
                Stroke="{x:Bind BtnStroke.Foreground, Mode=OneWay}"
                StrokeThickness="9"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"/>

                            <!-- 2 : 긴 눈금 -->
                            <Path
                Data="M 24,70 L 56,70"
                Stroke="{x:Bind BtnStroke.Foreground, Mode=OneWay}"
                StrokeThickness="9"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"/>

                            <!-- 3 : 짧은 눈금 -->
                            <Path
                Data="M 24,97 L 41,97"
                Stroke="{x:Bind BtnStroke.Foreground, Mode=OneWay}"
                StrokeThickness="9"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"/>

                            <!-- 4 : 긴 눈금 -->
                            <Path
                Data="M 24,124 L 56,124"
                Stroke="{x:Bind BtnStroke.Foreground, Mode=OneWay}"
                StrokeThickness="9"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"/>

                            <!-- 5 : 짧은 눈금 -->
                            <Path
                Data="M 24,151 L 41,151"
                Stroke="{x:Bind BtnStroke.Foreground, Mode=OneWay}"
                StrokeThickness="9"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"/>

                            <!-- 6 : 긴 눈금 -->
                            <Path
                Data="M 24,178 L 56,178"
                Stroke="{x:Bind BtnStroke.Foreground, Mode=OneWay}"
                StrokeThickness="9"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"/>

                            <!-- 7 : 짧은 눈금 -->
                            <Path
                Data="M 24,205 L 41,205"
                Stroke="{x:Bind BtnStroke.Foreground, Mode=OneWay}"
                StrokeThickness="9"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"/>

                        </Grid>
                    </Viewbox>

                </Button>

                <!-- 2. ANGLE CONTROL -->
                <Button Loaded="OnLocalizedLoaded" x:Name="BtnAngle" Visibility="Collapsed"
        Grid.Row="0"
        Grid.Column="3" Grid.ColumnSpan="2"
        Style="{StaticResource MenuButtonStyle}"
        Tag="ANGLE CONTROL"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        PointerEntered="MenuButton_PointerEntered"
        PointerExited="MenuButton_PointerExited"
        Click="MenuButton_Click">

                    <!-- 원본 이미지 비율에 가깝게 유지 -->
                    <Viewbox Width="90"
             Height="90"
             Stretch="Uniform">

                        <!-- 첨부 이미지 비율 기준 -->
                        <Grid Width="248"
              Height="178">

                            <!-- =====================================================
                 1. 메인 각도 외곽선
                 - 좌측 꼭짓점에서 시작
                 - 우상향 사선
                 - 우측으로 길게 뻗는 기준선
                 ===================================================== -->
                            <Path
                Data="
                    M 12,162 L 140,34
                    M 12,162 L 236,162"
                Stroke="{x:Bind BtnAngle.Foreground, Mode=OneWay}"
                StrokeThickness="10"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                Fill="Transparent"/>

                            <!-- =====================================================
                 2. 각도 표시 아크
                 - 좌측 꼭짓점을 중심으로 한 아크 형태
                 - 시작점은 사선 위
                 - 끝점은 기준선 위
                 ===================================================== -->
                            <Path
                Data="
                    M 77,97
                    A 92,92 0 0 1 105,162"
                Stroke="{x:Bind BtnAngle.Foreground, Mode=OneWay}"
                StrokeThickness="10"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"
                StrokeLineJoin="Round"
                Fill="Transparent"/>

                        </Grid>
                    </Viewbox>
                </Button>

                <!-- 3. WEIGHING CONTROL -->
                <Button Loaded="OnLocalizedLoaded" x:Name="BtnWeighing" Visibility="Collapsed"
        Grid.Row="0"
        Grid.Column="5" Grid.ColumnSpan="2"
        Style="{StaticResource MenuButtonStyle}"
        Tag="WEIGHING CONTROL"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        PointerEntered="MenuButton_PointerEntered"
        PointerExited="MenuButton_PointerExited"
        Click="MenuButton_Click">

                    <!--
        첨부 이미지 비율을 유지하기 위해
        정사각형이 아니라 세로가 약간 긴 ViewBox 사용
    -->
                    <Viewbox Width="90"
             Height="98"
             Stretch="Uniform">

                        <Grid Width="100"
              Height="108">

                            <!-- =====================================================
                 1. 상단 계량 받침대
                 원본 이미지의 두꺼운 둥근 Tray 형태
                 ===================================================== -->
                            <Path
                Data="
                    M 10,6
                    L 90,6
                    C 92,6 93,7 93,9
                    L 93,11
                    C 93,16 89,19 84,19
                    L 16,19
                    C 11,19 7,16 7,11
                    L 7,9
                    C 7,7 8,6 10,6
                    Z"
                Stroke="{x:Bind BtnWeighing.Foreground, Mode=OneWay}"
                StrokeThickness="4.5"
                StrokeLineJoin="Round"/>


                            <!-- =====================================================
                 2. 상단 받침대 연결 기둥
                 첨부 이미지처럼 두 개의 수직 지지부
                 ===================================================== -->
                            <Path
                Data="
                    M 44,19 L 44,27
                    M 56,19 L 56,27"
                Stroke="{x:Bind BtnWeighing.Foreground, Mode=OneWay}"
                StrokeThickness="4.5"
                StrokeStartLineCap="Square"
                StrokeEndLineCap="Square"/>


                            <!-- =====================================================
                 3. 저울 전체 Body
                 상단은 원형으로 올라가고
                 하단은 직선 + 둥근 모서리
                 ===================================================== -->
                            <Path
                Data="
                    M 18,59

                    C 18,41
                      32,27
                      50,27

                    C 68,27
                      82,41
                      82,59

                    L 82,91

                    C 82,100
                      76,105
                      68,105

                    L 32,105

                    C 24,105
                      18,100
                      18,91

                    Z"
                Stroke="{x:Bind BtnWeighing.Foreground, Mode=OneWay}"
                StrokeThickness="4.5"
                StrokeLineJoin="Round"/>


                            <!-- =====================================================
                 4. 내부 계기판 원
                 첨부 그림보다 너무 작아 보이지 않도록 확대
                 ===================================================== -->
                            <Path
                Data="
                    M 50,33

                    A 26,26
                      0 1 1
                      50,85

                    A 26,26
                      0 1 1
                      50,33"
                Stroke="{x:Bind BtnWeighing.Foreground, Mode=OneWay}"
                StrokeThickness="4.5"
                StrokeLineJoin="Round"/>


                            <!-- =====================================================
                 5. 계기판 ↔ Body 연결 Tick
                 원본 이미지의 상/하/좌/우 4방향 구조
                 ===================================================== -->
                            <Path
                Data="
                    M 50,27 L 50,33
                    M 18,59 L 24,59
                    M 76,59 L 82,59
                    M 50,85 L 50,92"
                Stroke="{x:Bind BtnWeighing.Foreground, Mode=OneWay}"
                StrokeThickness="4.5"
                StrokeStartLineCap="Square"
                StrokeEndLineCap="Square"/>


                            <!-- =====================================================
                 6. 하단 베이스 분할선
                 ===================================================== -->
                            <Path
                Data="M 18,93 L 82,93"
                Stroke="{x:Bind BtnWeighing.Foreground, Mode=OneWay}"
                StrokeThickness="4.5"
                StrokeStartLineCap="Square"
                StrokeEndLineCap="Square"/>


                            <!-- =====================================================
                 7. 중앙 Pivot
                 첨부 이미지처럼 두꺼운 원형
                 ===================================================== -->
                            <Path
                Data="
                    M 58,59

                    A 8,8
                      0 1 1
                      42,59

                    A 8,8
                      0 1 1
                      58,59"
                Stroke="{x:Bind BtnWeighing.Foreground, Mode=OneWay}"
                StrokeThickness="4.5"
                StrokeLineJoin="Round"/>


                            <!-- =====================================================
                 8. 계량 바늘
                 중앙 Pivot에서 약 2시 방향
                 ===================================================== -->
                            <Path
                Data="M 55.5,53.5 L 65.5,43.5"
                Stroke="{x:Bind BtnWeighing.Foreground, Mode=OneWay}"
                StrokeThickness="4.5"
                StrokeStartLineCap="Round"
                StrokeEndLineCap="Round"/>

                        </Grid>
                    </Viewbox>

                </Button>

                <!-- 4. CALIBRATION -->
                <Button Loaded="OnLocalizedLoaded" x:Name="BtnCalib"
        Grid.Row="1"
        Grid.Column="0" Grid.ColumnSpan="2"
        Style="{StaticResource MenuButtonStyle}"
        Tag="Calibration"
        HorizontalContentAlignment="Center"
        VerticalContentAlignment="Center"
        PointerEntered="MenuButton_PointerEntered"
        PointerExited="MenuButton_PointerExited"
        Click="StrandPreview_Click">

                    <!--
        원본 이미지 비율 : 124 x 240
        정사각형 좌표계로 찌그러뜨리지 않고 원본 종횡비 유지
    -->
                    <Viewbox Width="90"
             Height="90"
             Stretch="Uniform">

                        <Grid Width="124"
              Height="240">

                            <Path Data="M 0,91 L 30,38 L 60,91 Z" Fill="#F5272E" Stroke="Black" StrokeThickness="5"/>
                            <Path Data="M 30,57 L 30,73 M 30,80 L 30,82" Stroke="Black" StrokeThickness="5" StrokeStartLineCap="Round"/>

                            <!-- =====================================================
                 1. 긴 중앙 샤프트 / 손잡이
                 하단 끝은 원본처럼 U자형으로 둥글게 마감
                 ===================================================== -->
                            <Path
                Data="
                    M 61,96
                    L 61,222
                    C 61,230
                      66,234
                      73,234
