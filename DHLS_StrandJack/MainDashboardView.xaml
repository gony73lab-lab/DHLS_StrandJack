<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="DHLS_StrandJack.MainDashboardView"
    x:Name="DashboardRoot"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d"
    MinWidth="0" MinHeight="0" RequestedTheme="Light"
    SizeChanged="DashboardRoot_SizeChanged" Loaded="EquipmentView_Loaded" Unloaded="EquipmentView_Unloaded">
    <!--
        MainDashboardView is driven by JackArrangementView's CONFIRMED template.
        Host event: ArrangementConfirmed => ApplyConfirmedArrangementJson(
          arrangement.ConfirmedArrangementJson()).
        T1=one line of eight; T2=two parallel lines, four ports on each side per row.
    -->
    <UserControl.Resources>
        <LinearGradientBrush x:Key="HeaderGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#686868" Offset="0"/>
            <GradientStop Color="#303030" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LeftTopGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#606060" Offset="0"/>
            <GradientStop Color="#303030" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="LightButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#F8F8F8" Offset="0"/>
            <GradientStop Color="#C8C8C8" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="WhiteButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FFFFFF" Offset="0"/>
            <GradientStop Color="#D0D0D0" Offset="1"/>
        </LinearGradientBrush>
        <LinearGradientBrush x:Key="DarkButtonGradient" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#585858" Offset="0"/>
            <GradientStop Color="#282828" Offset="1"/>
        </LinearGradientBrush>
        <SolidColorBrush x:Key="DarkStroke" Color="#181818"/>
        <SolidColorBrush x:Key="ActiveGreen" Color="#60FF20"/>
        <Style x:Key="HeaderIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="64"/>
            <Setter Property="Height" Value="64"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="HeaderIconBorder" Background="{TemplateBinding Background}" CornerRadius="10">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver"><VisualState.Setters><Setter Target="HeaderIconBorder.Background" Value="#0056A8"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Pressed"><VisualState.Setters><Setter Target="HeaderIconBorder.Background" Value="#004886"/></VisualState.Setters></VisualState>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter Content="{TemplateBinding Content}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="FlatStatusButtonTemplate" TargetType="Button">
            <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="ButtonText.Foreground" Value="#009DFF"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="ButtonText.Foreground" Value="#009DFF"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled"/>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="ButtonText" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="EmergencyButtonTemplate" TargetType="Button">
            <Border x:Name="EmergencySurface" Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="EmergencySurface.Background" Value="#FF0000"/>
                                <Setter Target="EmergencyContent.Foreground" Value="#FFFF00"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="EmergencySurface.Background" Value="#D00000"/>
                                <Setter Target="EmergencyContent.Foreground" Value="#FFFF00"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled"/>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="EmergencyContent" Content="{TemplateBinding Content}"
                                  Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
        <Style x:Key="ModeButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatStatusButtonTemplate}"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="{StaticResource LightButtonGradient}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="#808080"/>
            <Setter Property="FontSize" Value="23"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
        </Style>
        <Style x:Key="SmallControlButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatStatusButtonTemplate}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="Background" Value="{StaticResource DarkButtonGradient}"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
        <Style x:Key="OperationButtonStyle" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">
                                    <VisualState x:Name="Normal"/>
                                    <VisualState x:Name="PointerOver">
                                        <VisualState.Setters>
                                            <Setter Target="OperationButtonContent.Foreground" Value="LimeGreen"/>
                                        </VisualState.Setters>
                                    </VisualState>
                                    <VisualState x:Name="Pressed"/>
                                    <VisualState x:Name="Disabled"/>
                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>
                            <ContentPresenter x:Name="OperationButtonContent" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <ControlTemplate x:Key="FooterSpeedTicks" TargetType="ContentControl">
            <Viewbox Height="8" Stretch="Fill" VerticalAlignment="Center" Margin="10,17,10,0" IsHitTestVisible="False">
                <Canvas Width="162" Height="8">
                    <Path Stroke="#888888" StrokeThickness="1" Data="M 21,0 L 21,4 M 61,0 L 61,4 M 101,0 L 101,4 M 141,0 L 141,4"/>
                    <Path Stroke="#666666" StrokeThickness="1.4" Data="M 1,0 L 1,8 M 41,0 L 41,8 M 81,0 L 81,8 M 121,0 L 121,8 M 161,0 L 161,8"/>
                </Canvas>
            </Viewbox>
        </ControlTemplate>
        <ControlTemplate x:Key="TensionChoiceTemplate" TargetType="RadioButton">
            <Grid Background="Transparent">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CheckStates">
                        <VisualState x:Name="Unchecked"/>
                        <VisualState x:Name="Checked">
                            <VisualState.Setters><Setter Target="TensionCheck.Opacity" Value="1"/></VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <Border Width="31" Height="31" Background="Black" BorderBrush="#777777" BorderThickness="1"
                        HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path x:Name="TensionCheck" Data="M 3,14 L 10,21 L 25,4" Stroke="#60FF20" StrokeThickness="3"
                          Opacity="0" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>
        </ControlTemplate>
        <LinearGradientBrush x:Key="FooterDirectionHoverBrush" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#008080" Offset="0"/>
            <GradientStop Color="#083E40" Offset="1"/>
        </LinearGradientBrush>
        <ControlTemplate x:Key="FooterDirectionTemplate" TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="Surface.Background" Value="{StaticResource FooterDirectionHoverBrush}"/>
                                <Setter Target="Label.Foreground" Value="#00FF00"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="Surface.Background" Value="#FFFF00"/>
                                <Setter Target="Label.Foreground" Value="#111111"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled"/>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="FooterCalibrationTemplate" TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="Label.Foreground" Value="LimeGreen"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="Surface.Background" Value="#FFA500"/>
                                <Setter Target="Label.Foreground" Value="#111111"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled"/>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="FooterWedgeCloseTemplate" TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="Surface.Background" Value="#00A000"/>
                                <Setter Target="Label.Foreground" Value="#FF2020"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="Surface.Background" Value="#FFFF00"/>
                                <Setter Target="Label.Foreground" Value="#111111"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled"/>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="FooterWedgeOpenTemplate" TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="Surface.Background" Value="#E00000"/>
                                <Setter Target="Label.Foreground" Value="#32CD32"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="Surface.Background" Value="#FFFF00"/>
                                <Setter Target="Label.Foreground" Value="#111111"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled"/>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
        <ControlTemplate x:Key="FooterTensionStartTemplate" TargetType="Button">
            <Border x:Name="Surface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal"/>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Target="Label.Foreground" Value="LimeGreen"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Target="Surface.Background" Value="LimeGreen"/>
                                <Setter Target="Label.Foreground" Value="#111111"/>
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Disabled"/>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
                <ContentPresenter x:Name="Label" Content="{TemplateBinding Content}" Foreground="{TemplateBinding Foreground}"
                                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
        </ControlTemplate>
        <Style x:Key="ModeFooterButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatStatusButtonTemplate}"/>
            <Setter Property="Background" Value="{StaticResource DarkButtonGradient}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource DarkStroke}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="FontSize" Value="18"/>
        </Style>
        <Style x:Key="ArrowButtonStyle" TargetType="Button">
            <Setter Property="Template" Value="{StaticResource FlatStatusButtonTemplate}"/>
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Background" Value="Transparent"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="CornerRadius" Value="0"/>
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
        </Style>
    </UserControl.Resources>

    <Grid Background="#888888">
        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="32"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>
        <Grid x:Name="MainDashboardHeader" Grid.Row="0" Background="Red"
              ToolTipService.ToolTip="{x:Bind ModelTitle, Mode=OneTime}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="200"/>
            </Grid.ColumnDefinitions>
            <Button x:Name="CaptureButton" Grid.Column="0" Style="{StaticResource HeaderIconButtonStyle}" Margin="100,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Click="CaptureButton_Click"
                    Loaded="OnLocalizedLoaded" ToolTipService.ToolTip="캡처">
                <Viewbox Width="54" Height="54" Stretch="Uniform">
                    <Canvas Width="72" Height="68">
                        <!-- Rounded body, raised viewfinder, lens and flash. -->
                        <Path Data="M22,18 L29,6 H45 L52,18 H61 C66,18 69,21 69,26 V55 C69,60 66,63 61,63 H11 C6,63 3,60 3,55 V26 C3,21 6,18 11,18 Z"
                              Stroke="White" StrokeThickness="5" StrokeLineJoin="Round" Fill="Transparent"/>
                        <Ellipse Canvas.Left="22" Canvas.Top="26" Width="28" Height="28"
                                 Stroke="White" StrokeThickness="5" Fill="Transparent"/>
                        <Path Data="M28,38 C28,33 31,30 36,30"
                              Stroke="White" StrokeThickness="1.5" StrokeStartLineCap="Round"
                              StrokeEndLineCap="Round" Opacity="0.65"/>
                        <Rectangle Canvas.Left="55" Canvas.Top="25" Width="7" Height="4"
                                   RadiusX="1" RadiusY="1" Fill="White"/>
                        <Rectangle Canvas.Left="11" Canvas.Top="12" Width="8" Height="3"
                                   RadiusX="1" RadiusY="1" Fill="White"/>
                    </Canvas>
                </Viewbox>
            </Button>
            <Border x:Name="SimulationHeaderBadge" Grid.Column="1" Margin="4,0,0,0"
                    HorizontalAlignment="Left" VerticalAlignment="Center" Padding="6,8" CornerRadius="5"
                    Background="#FFD54F" Visibility="Collapsed" IsHitTestVisible="False">
                <TextBlock Loaded="OnLocalizedLoaded" x:Name="SimulationHeaderText" Text="시뮬레이션" Foreground="#181818"
                           FontSize="14" FontWeight="Bold" TextAlignment="Center"/>
            </Border>
            <Viewbox Grid.Column="1" Stretch="Uniform" StretchDirection="DownOnly" Margin="16,0">
                <StackPanel Orientation="Horizontal" Spacing="16" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="DashboardModelNameText" Foreground="White" FontSize="36" FontWeight="Bold"
                               MaxWidth="240" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                    <TextBlock x:Name="SystemTitleText" Loaded="OnLocalizedLoaded" Text="SYNCHRONOUS LIFTING SYSTEM"
                               Foreground="White" FontSize="36" FontWeight="Bold"/>
                    <TextBlock x:Name="SystemVersionText" Foreground="#d1d5db" FontSize="14" FontWeight="SemiBold"
                               VerticalAlignment="Bottom" Margin="0,0,0,6"/>
                </StackPanel>
            </Viewbox>
            <Button x:Name="HeaderLogoButton" Grid.Column="2" Click="HeaderLogoButton_Click"
                    Loaded="OnLocalizedLoaded" ToolTipService.ToolTip="최소화" AutomationProperties.Name="최소화"
                    HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,6,0"
                    Padding="0" Background="Transparent" BorderThickness="0">
                <Image Source="ms-appx:///Assets/DHLS_Logo_White_Transparent.png" Width="180" Stretch="Uniform"/>
            </Button>
        </Grid>
    <Grid Grid.Row="1" Background="#303030" Padding="8,0">
        <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
        <Button x:Name="EquipmentConnectButton" Loaded="OnLocalizedLoaded" Content="PLC 연결" Click="EquipmentConnect_Click" FontSize="12" Padding="10,2" VerticalAlignment="Center"/>
        <Grid Grid.Column="1" VerticalAlignment="Center" Margin="12,0">
            <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <TextBlock Loaded="OnLocalizedLoaded" Text="실장비 읽기 전용" Foreground="#FFD34D" FontSize="12" Margin="0,0,14,0"/>
            <TextBlock x:Name="EquipmentStatusText" Grid.Column="1" Loaded="OnLocalizedLoaded" Text="연결 대기" Foreground="White" FontSize="12" TextTrimming="CharacterEllipsis"/>
        </Grid>
        <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
            <Button x:Name="PlcMapButton" Loaded="OnLocalizedLoaded" AutomationProperties.Name="PLC 맵" Click="PlcMap_Click" Padding="10,2" FontSize="12"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE9D9;" FontSize="14"/><TextBlock Loaded="OnLocalizedLoaded" Text="PLC 맵"/></StackPanel></Button>
            <Button x:Name="PressureDiagnosticsButton" Click="PressureDiagnostics_Click" Padding="10,2" FontSize="12"><StackPanel Orientation="Horizontal" Spacing="5"><FontIcon Glyph="&#xE9D9;" FontSize="14"/><TextBlock Loaded="OnLocalizedLoaded" x:Name="PressureDiagnosticsLabel" Text="압력 자동 진단"/></StackPanel></Button>
            <Button Content="COG" Tag="CenterOfGravity" IsEnabled="False" Padding="10,2" FontSize="12"/>
        </StackPanel>
    </Grid>
    <Viewbox Grid.Row="2" Stretch="Uniform" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
    <Grid x:Name="DashboardGrid" Width="1920" Height="1010" Background="#888888">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="169"/>
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="LeftPanelColumn" Width="328"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Bottom operation panel: emergency, distances, actions, load, speed and log. -->
        <Border Grid.Row="1" Grid.ColumnSpan="2" Background="#888888"
                BorderBrush="{StaticResource DarkStroke}" BorderThickness="0,4,0,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="0"/>
                </Grid.RowDefinitions>
                <ScrollViewer Grid.Row="1" Visibility="Collapsed" HorizontalScrollBarVisibility="Auto"
                              VerticalScrollBarVisibility="Disabled">
                    <StackPanel x:Name="OperationStrip" Orientation="Horizontal">
                        <!-- Back / lock -->
                        <Border x:Name="TopNavigationPanel" Height="64" Background="Transparent"
                                BorderThickness="0">
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="0"/></Grid.ColumnDefinitions>
                                <Button x:Name="BackNavigationButton" Loaded="OnLocalizedLoaded" Grid.Column="0" Style="{StaticResource HeaderIconButtonStyle}" HorizontalAlignment="Left"
                                        AutomationProperties.Name="뒤로" ToolTipService.ToolTip="뒤로" Click="BackButton_Click">
                                    <Viewbox Width="54" Height="54"><Path Width="64" Height="64" Stretch="Fill" Fill="White" Data="M4,32 C4,30 5,29 7,27 L29,5 C34,0 41,4 41,10 L41,17 L57,17 C61,17 64,20 64,24 L64,40 C64,44 61,47 57,47 L41,47 L41,54 C41,60 34,64 29,59 L7,37 C5,35 4,34 4,32 Z"/></Viewbox>
                                </Button>
                                <Button x:Name="LockButton" Style="{StaticResource HeaderIconButtonStyle}" Loaded="OnLocalizedLoaded" Grid.Column="1" HorizontalAlignment="Right"
                                        AutomationProperties.Name="잠금" ToolTipService.ToolTip="잠금" Click="LockButton_Click"><FontIcon Glyph="&#xE785;" FontSize="48" Foreground="White"/></Button>
                            </Grid>
                        </Border>
                        <!-- Main mode -->
                        <Grid Height="74" Margin="0,18,0,0">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Loaded="OnLocalizedLoaded" x:Name="DisplacementModeButton" Grid.Column="0"
                                    Style="{StaticResource ModeButtonStyle}" Content="변위제어"
                                    Click="DisplacementModeButton_Click"/>
                            <Button Loaded="OnLocalizedLoaded" x:Name="PressureModeButton" Grid.Column="1"
                                    Style="{StaticResource ModeButtonStyle}" Content="압력제어"
                                    Click="PressureModeButton_Click"/>
                        </Grid>
                        <!-- Auto / manual -->
                        <Grid Height="74">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Loaded="OnLocalizedLoaded" x:Name="AutoModeButton" Grid.Column="0"
                                    Style="{StaticResource ModeButtonStyle}" FontSize="20"
                                    Content="자동모드" Click="AutoModeButton_Click"/>
                            <Button Loaded="OnLocalizedLoaded" x:Name="ManualModeButton" Grid.Column="1"
                                    Style="{StaticResource ModeButtonStyle}" FontSize="20"
                                    Content="수동모드" Click="ManualModeButton_Click"/>
                        </Grid>
                        <!-- Zero controls -->
                        <Grid x:Name="ZeroControlsPanel" Height="48">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Button Loaded="OnLocalizedLoaded" Grid.Column="0" Style="{StaticResource SmallControlButtonStyle}"
                                    Click="HeightZeroButton_Click"><TextBlock Loaded="OnLocalizedLoaded" Text="HEIGHT&#10;ZERO" TextAlignment="Center"/></Button>
                            <Button Loaded="OnLocalizedLoaded" Grid.Column="1" Style="{StaticResource SmallControlButtonStyle}"
                                    Click="PressureZeroButton_Click"><TextBlock Loaded="OnLocalizedLoaded" Text="PRESSURE&#10;ZERO" TextAlignment="Center"/></Button>
                            <Button Loaded="OnLocalizedLoaded" Grid.Column="2" Style="{StaticResource SmallControlButtonStyle}"
                                    Click="LoadSetButton_Click"><TextBlock Loaded="OnLocalizedLoaded" Text="LOAD&#10;SET" TextAlignment="Center"/></Button>
                        </Grid>
                        <!-- Up / down request buttons -->
