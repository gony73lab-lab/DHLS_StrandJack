                        VerticalAlignment="Center" IsHitTestVisible="False">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Loaded="OnLocalizedLoaded" Text="현재 시각" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DashboardCurrentTime" Text="--:--:--" Foreground="White" FontSize="18"
                               FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
                <Border Width="1" Height="20" Background="#CCFFFFFF" VerticalAlignment="Center"/>
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <TextBlock Loaded="OnLocalizedLoaded" Text="운전 시간" Foreground="White" VerticalAlignment="Center"/>
                    <TextBlock x:Name="DashboardElapsedTime" Text="00:00:00" Foreground="#FFF59D" FontSize="18"
                               FontFamily="Consolas" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
            </StackPanel>
            </Grid>
            <Border x:Name="PlcFaultOverlay" Visibility="Collapsed" VerticalAlignment="Center"
                    HorizontalAlignment="Center" MaxWidth="760" MaxHeight="450" Margin="16" Padding="20"
                    Background="#FFF7ED" BorderBrush="#DC2626" BorderThickness="3" CornerRadius="12">
                <StackPanel Spacing="12">
                    <StackPanel Orientation="Horizontal" Spacing="12"><FontIcon Glyph="&#xE7BA;" Foreground="#DC2626" FontSize="30"/>
                        <TextBlock Loaded="OnLocalizedLoaded" x:Name="PlcFaultTitle" Text="PLC 고장 — 정지" Foreground="#991B1B" FontSize="22" FontWeight="Bold"/></StackPanel>
                    <ScrollViewer MaxHeight="310" VerticalScrollBarVisibility="Auto">
                        <TextBlock x:Name="PlcFaultText" Foreground="#7F1D1D" FontSize="16" TextWrapping="Wrap"/>
                    </ScrollViewer>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
    </Viewbox>
        <Border x:Name="EmergencySignalOverlay" Grid.RowSpan="3"
                HorizontalAlignment="Center" VerticalAlignment="Center"
                Visibility="Collapsed" IsHitTestVisible="False"
                MaxWidth="400" MaxHeight="400" Margin="24"
                BorderBrush="White" BorderThickness="3" Background="#880000">
            <Image Source="ms-appx:///Assets/EmergencyStop.png" Stretch="Uniform"/>
        </Border>
    </Grid>
</UserControl>
